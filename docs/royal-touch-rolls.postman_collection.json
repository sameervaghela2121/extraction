{
  "info": {
    "name": "Royal Touch \u2014 Rolls & Label OCR",
    "description": "Endpoints affected by the roll field rename (weight / width / date), the newly required fields, the auto-generated royal_touche_code, and the Gemini-only label reader.\n\nSet the `base_url` and `token` collection variables before running. `POST /auth/login` writes `token` automatically.\n\nOrder matters: run Auth, then Masters, then Create roll (sets roll_id), before the Stock Movements folder.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "material_id",
      "value": ""
    },
    {
      "key": "vendor_id",
      "value": ""
    },
    {
      "key": "roll_id",
      "value": ""
    },
    {
      "key": "photo_path",
      "value": ""
    },
    {
      "key": "roll_number",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "const token = body.token || body.data?.token || body.accessToken;",
                  "if (token) { pm.collectionVariables.set('token', token); }",
                  "pm.test('login returns a token', () => pm.expect(token).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"\",\n  \"password\": \"\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Masters",
      "item": [
        {
          "name": "List raw materials (get material_id)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const items = pm.response.json().data ?? pm.response.json();",
                  "const tissue = (items.items ?? items).find(m => m.material_code === 'TISSUE');",
                  "if (tissue) pm.collectionVariables.set('material_id', tissue.id ?? tissue._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/raw-materials",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "raw-materials"
              ]
            }
          }
        },
        {
          "name": "List vendors (get vendor_id)",
          "description": "vendor_code here becomes the prefix of every royal_touche_code \u2014 ITC, SCHATT.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "const list = body.items ?? body.data?.items ?? body.data ?? body;",
                  "if (list[0]) pm.collectionVariables.set('vendor_id', list[0].id ?? list[0]._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/vendors",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "vendors"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Material Rolls",
      "item": [
        {
          "name": "Create roll \u2014 all required fields",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('created', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "const body = pm.response.json();",
                  "const roll = body.data ?? body;",
                  "if (roll.id) pm.collectionVariables.set('roll_id', roll.id);",
                  "if (roll.roll_number) pm.collectionVariables.set('roll_number', roll.roll_number);",
                  "pm.test('royal_touche_code was generated', () =>",
                  "  pm.expect(roll.royal_touche_code).to.match(/^[A-Z0-9]+-\\d{4,}$/));",
                  "pm.test('uses the new field names', () => {",
                  "  pm.expect(roll).to.have.property('weight');",
                  "  pm.expect(roll).to.have.property('width');",
                  "  pm.expect(roll).to.have.property('date');",
                  "  pm.expect(roll).to.not.have.property('initial_weight');",
                  "  pm.expect(roll).to.not.have.property('width_mm');",
                  "  pm.expect(roll).to.not.have.property('received_date');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/material-rolls",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "material-rolls"
              ]
            },
            "description": "Required: roll_number, material_id, vendor_id, weight, gsm, width, location, date.\nOptional: batch_no, quantity, unit (defaults kg), and the four *_photo_path fields.\nNever send: royal_touche_code (generated), remaining_weight, status.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roll_number\": \"RT-{{$randomInt}}\",\n  \"material_id\": \"{{material_id}}\",\n  \"vendor_id\": \"{{vendor_id}}\",\n  \"weight\": 275,\n  \"gsm\": 80,\n  \"width\": 1250,\n  \"location\": \"A-12\",\n  \"date\": \"2026-08-24\"\n}"
            }
          }
        },
        {
          "name": "Create roll \u2014 missing required field (expect 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('rejected with 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/material-rolls",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "material-rolls"
              ]
            },
            "description": "gsm, width, location and date omitted \u2014 each is now required.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roll_number\": \"RT-MISSING-{{$randomInt}}\",\n  \"material_id\": \"{{material_id}}\",\n  \"vendor_id\": \"{{vendor_id}}\",\n  \"weight\": 275\n}"
            }
          }
        },
        {
          "name": "List rolls (q also searches royal_touche_code)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/material-rolls?page=1&pageSize=50",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "material-rolls"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "50"
                },
                {
                  "key": "q",
                  "value": "ITC-0001",
                  "disabled": true
                },
                {
                  "key": "material_id",
                  "value": "{{material_id}}",
                  "disabled": true
                },
                {
                  "key": "vendor_id",
                  "value": "{{vendor_id}}",
                  "disabled": true
                },
                {
                  "key": "status",
                  "value": "IN_STOCK",
                  "disabled": true
                },
                {
                  "key": "location",
                  "value": "A-12",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Get roll (by id or roll_number)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/material-rolls/{{roll_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "material-rolls",
                "{{roll_id}}"
              ]
            }
          }
        },
        {
          "name": "Update roll",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/material-rolls/{{roll_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "material-rolls",
                "{{roll_id}}"
              ]
            },
            "description": "PATCH is partial \u2014 send only what changes. remaining_weight and status are refused here: both move only through stock movements. royal_touche_code is not patchable.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"gsm\": 85,\n  \"location\": \"B-04\"\n}"
            }
          }
        },
        {
          "name": "Delete roll",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/material-rolls/{{roll_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "material-rolls",
                "{{roll_id}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Label OCR",
      "item": [
        {
          "name": "Read roll label (Gemini)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "pm.test('field names match the roll API', () => {",
                  "  pm.expect(r).to.have.property('weight');",
                  "  pm.expect(r).to.have.property('width');",
                  "  pm.expect(r).to.have.property('date');",
                  "  pm.expect(r).to.not.have.property('weight_kg');",
                  "  pm.expect(r).to.not.have.property('width_mm');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/ocr/roll-label",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "ocr",
                "roll-label"
              ]
            },
            "description": "Attach the label photo as form-data key `photo`.\n\nServed by Gemini (EasyOCR removed). Returns roll_number, gsm, width, weight, batch_no, date, plus matched material/vendor, confidence, reliable and raw_text. When reliable is false every field is null \u2014 do not pre-fill the form.\n\nThe field names match POST /material-rolls exactly; only `location` still has to be entered by hand.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "photo",
                  "type": "file",
                  "src": []
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Stock Movements (Roll In / Out)",
      "item": [
        {
          "name": "Upload a photo (get photo_paths)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "const path = b.path ?? b.data?.path ?? b.object_path;",
                  "if (path) pm.collectionVariables.set('photo_path', path);",
                  "pm.test('returns an object path', () => pm.expect(path).to.match(/^rolls\\/\\d{4}\\/\\d{2}\\//));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/media/upload",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "media",
                "upload"
              ]
            },
            "description": "Attach the image as form-data key `file`. Returns the GCS object path (rolls/YYYY/MM/<uuid>.<ext>) to put in photo_paths or the roll's *_photo_path fields.\n\nPaths, not URLs \u2014 a stored URL expires, a path does not.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            }
          }
        },
        {
          "name": "Roll OUT \u2014 issue whole roll to a location",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('recorded', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "const m = pm.response.json().data ?? pm.response.json();",
                  "pm.test('OUT moves no weight', () => pm.expect(m.delta ?? 0).to.eql(0));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/stock/movements",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "stock",
                "movements"
              ]
            },
            "description": "A whole roll leaves the store. OUT changes no weight \u2014 nothing is consumed yet, the roll is just somewhere else. Consumption is declared on RETURN.\n\nRequired: transaction_type, material_id, roll_id, location.\nRejected: weight (the amount used is recorded when it comes back).\nOptional: issued_to, remarks, photo_paths (max 4), transaction_date.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transaction_type\": \"OUT\",\n  \"material_id\": \"{{material_id}}\",\n  \"roll_id\": \"{{roll_id}}\",\n  \"location\": \"Machine-2\",\n  \"issued_to\": \"Ramesh\",\n  \"remarks\": \"For run 4471\",\n  \"photo_paths\": []\n}"
            }
          }
        },
        {
          "name": "Roll OUT \u2014 missing location (expect 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('rejected with 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/stock/movements",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "stock",
                "movements"
              ]
            },
            "description": "OUT without a destination is refused: 'Where is the roll going? location is required'.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transaction_type\": \"OUT\",\n  \"material_id\": \"{{material_id}}\",\n  \"roll_id\": \"{{roll_id}}\"\n}"
            }
          }
        },
        {
          "name": "Roll RETURN \u2014 bring it back and declare what is left",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('recorded', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/stock/movements",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "stock",
                "movements"
              ]
            },
            "description": "The only movement that draws a roll down. returned_weight is what the roll weighs coming back: equal to what went out means nothing was used, 0 means fully consumed (the roll goes CONSUMED).\n\nRequired: transaction_type, material_id, roll_id, returned_weight.\nOptional: remarks, photo_paths, transaction_date.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transaction_type\": \"RETURN\",\n  \"material_id\": \"{{material_id}}\",\n  \"roll_id\": \"{{roll_id}}\",\n  \"returned_weight\": 180,\n  \"remarks\": \"95 kg used on run 4471\",\n  \"photo_paths\": []\n}"
            }
          }
        },
        {
          "name": "Stock IN \u2014 add weight to an existing roll",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/stock/movements",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "stock",
                "movements"
              ]
            },
            "description": "Required: transaction_type, material_id, weight. Cannot take a roll above the weight it arrived with.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transaction_type\": \"IN\",\n  \"material_id\": \"{{material_id}}\",\n  \"roll_id\": \"{{roll_id}}\",\n  \"weight\": 50,\n  \"remarks\": \"Miscount on receipt\"\n}"
            }
          }
        },
        {
          "name": "ADJUSTMENT \u2014 correct a counted weight",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/stock/movements",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "stock",
                "movements"
              ]
            },
            "description": "State the corrected weight; the delta is derived. remarks is REQUIRED \u2014 an unexplained correction to a stock figure is the one thing nobody can audit later.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transaction_type\": \"ADJUSTMENT\",\n  \"material_id\": \"{{material_id}}\",\n  \"roll_id\": \"{{roll_id}}\",\n  \"new_weight\": 172.5,\n  \"remarks\": \"Physical count 2026-08-24\"\n}"
            }
          }
        },
        {
          "name": "ADJUSTMENT \u2014 no remarks (expect 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('rejected with 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/stock/movements",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "stock",
                "movements"
              ]
            },
            "description": "Proves the audit rule: an adjustment without a reason is refused.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transaction_type\": \"ADJUSTMENT\",\n  \"material_id\": \"{{material_id}}\",\n  \"roll_id\": \"{{roll_id}}\",\n  \"new_weight\": 172.5\n}"
            }
          }
        }
      ]
    },
    {
      "name": "History & Summary",
      "item": [
        {
          "name": "Movement history (all)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('ok', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/stock/movements?page=1&pageSize=50",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "stock",
                "movements"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "50"
                }
              ]
            },
            "description": null
          }
        },
        {
          "name": "Movement history \u2014 one roll",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/stock/movements?roll_id={{roll_id}}&page=1&pageSize=50",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "stock",
                "movements"
              ],
              "query": [
                {
                  "key": "roll_id",
                  "value": "{{roll_id}}"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "50"
                }
              ]
            },
            "description": "Full in/out history for a single roll, newest first. Movements carry photo_paths and signed photo_urls for the shots taken on OUT and RETURN."
          }
        },
        {
          "name": "Movement history \u2014 one roll by roll_number",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('ok', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "const items = b.items ?? b.data?.items ?? b.data ?? b;",
                  "pm.test('every row is the same roll', () => {",
                  "  items.forEach(t => pm.expect(t.roll_id?.roll_number ?? null)",
                  "    .to.eql(pm.collectionVariables.get('roll_number')));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/stock/movements?roll_number={{roll_number}}&page=1&pageSize=50",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "stock",
                "movements"
              ],
              "query": [
                {
                  "key": "roll_number",
                  "value": "{{roll_number}}"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "50"
                }
              ]
            },
            "description": "Same history as ?roll_id=, addressed by the number printed on the roll \u2014 what a phone has straight after scanning the barcode. Case-insensitive (upper-cased server side).\n\nAn unknown roll_number returns an empty page, never the whole ledger."
          }
        },
        {
          "name": "Movement history \u2014 filtered by type",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/stock/movements?transaction_type=OUT",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "stock",
                "movements"
              ],
              "query": [
                {
                  "key": "transaction_type",
                  "value": "OUT"
                },
                {
                  "key": "material_id",
                  "value": "{{material_id}}",
                  "disabled": true
                }
              ]
            },
            "description": "transaction_type: IN | OUT | RETURN | ADJUSTMENT"
          }
        },
        {
          "name": "Stock summary",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/stock/summary",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "stock",
                "summary"
              ],
              "query": [
                {
                  "key": "material_id",
                  "value": "{{material_id}}",
                  "disabled": true
                }
              ]
            },
            "description": "On-hand totals. Omit material_id for every material."
          }
        }
      ]
    }
  ]
}