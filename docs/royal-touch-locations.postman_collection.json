{
  "info": {
    "name": "Royal Touch — Locations (Master)",
    "description": "CRUD for the location master — the godown bays a roll sits in and an OUT is issued to.\n\n**Point base_url at a THROWAWAY database** while testing: requests 5–8 create and deactivate real rows.\n\nThe six live bays load from `docs/locations-seed.json` with `npm run seed:locations` (dry run by default, `-- --apply` to write). Use this collection for one-off maintenance.\n\nReading is open to any signed-in user; creating, editing and deactivating need admin or store_manager.\n\nIMPORTANT: rolls and movements still store `location` as a plain STRING — the `name` from this list, not the id. This master exists to populate the dropdown, not to be referenced. Renaming a bay does not rewrite existing rolls.\n\nThe mobile app needs only the read (`GET /locations?status=active`) — it is request 4 in the Royal Touch — Offline Sync (Mobile) collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:4000/api"
    },
    {
      "key": "email",
      "value": "admin@docflow.app"
    },
    {
      "key": "password",
      "value": "admin@123"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "location_id",
      "value": ""
    },
    {
      "key": "new_location_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/auth/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "description": "Creating, editing and deactivating locations needs admin or store_manager. Everyone else can still read the list.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.collectionVariables.set('token', b.accessToken);",
              "pm.test('role can maintain masters', () =>",
              "  pm.expect(['admin','store_manager']).to.include(b.user.role));"
            ]
          }
        }
      ]
    },
    {
      "name": "2. List locations",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/locations",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "locations"
          ]
        },
        "description": "Every location, active and inactive. Filters: `q` (matches name, location_code or godown), `godown`, `status`.\n\nSorted by sort_order then name — the physical walk through the warehouse, not the alphabet. No pagination: master data, read whole into a picker."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const rows = pm.response.json();",
              "if (rows.length) pm.collectionVariables.set('location_id', rows[0].id);",
              "console.log(rows.map(l => `${l.sort_order}  ${l.location_code}  ${l.name}  [${l.status}]`));",
              "pm.test('sorted by sort_order, not alphabetically', () => {",
              "  const s = rows.filter(l => l.sort_order != null).map(l => l.sort_order);",
              "  pm.expect(s).to.eql(s.slice().sort((a,b) => a-b));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Active locations only",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/locations?status=active",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "locations"
          ],
          "query": [
            {
              "key": "status",
              "value": "active"
            }
          ]
        },
        "description": "What an operator's picker should request. Deactivated bays stay in the database so old rolls remain readable, but must not be offered for new stock."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "pm.test('no deactivated bays', () =>",
              "  pm.expect(pm.response.json().every(l => l.status === 'active')).to.be.true);"
            ]
          }
        }
      ]
    },
    {
      "name": "4. One location",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/locations/{{location_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "locations",
            "{{location_id}}"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Create location",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/locations",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "locations"
          ]
        },
        "description": "REQUIRED: location_code, name. Optional: godown, sort_order, status.\n\nlocation_code is uppercased and must be unique — a duplicate is a 409. It is the stable handle, so renaming a bay later does not break anything that referenced it.\n\n`godown` groups the sides of one building in a picker without parsing the name. `sort_order` is numbered in tens in the seed data so a new bay slots in without renumbering the rest.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"location_code\": \"GODOWN-C-1\",\n  \"name\": \"Godown C side 1\",\n  \"godown\": \"Godown C\",\n  \"sort_order\": 70\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201', () => pm.response.to.have.status(201));",
              "const b = pm.response.json();",
              "pm.collectionVariables.set('new_location_id', b.id);",
              "pm.test('code is uppercased', () => pm.expect(b.location_code).to.eql('GODOWN-C-1'));",
              "pm.test('starts active', () => pm.expect(b.status).to.eql('active'));"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Rename a location",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/locations/{{new_location_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "locations",
            "{{new_location_id}}"
          ]
        },
        "description": "Send only the fields being changed. Patchable: name, godown, sort_order, status. location_code can also be changed, and is re-checked for uniqueness.\n\nCAUTION: rolls and movements store the location as a plain STRING copied at the time. Renaming a bay does NOT rewrite history — old rows keep the old name. Rename for correcting a typo, not for repurposing a bay.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Godown C side 1 (north)\",\n  \"sort_order\": 75\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "pm.test('renamed', () => pm.expect(pm.response.json().name).to.eql('Godown C side 1 (north)'));"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Duplicate code is refused",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/locations",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "locations"
          ]
        },
        "description": "location_code is unique. The message is written to be shown to the user as-is.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"location_code\": \"GODOWN-C-1\",\n  \"name\": \"Something else\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('409', () => pm.response.to.have.status(409));",
              "console.log(pm.response.json().error);"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Deactivate a location",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{base_url}}/locations/{{new_location_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "locations",
            "{{new_location_id}}"
          ]
        },
        "description": "SOFT delete. The row is never removed: rolls and movements record where stock sat by name, and deleting would leave that history pointing at something nobody can look up.\n\nThe bay drops out of `?status=active` — i.e. out of the operator's picker — and can be brought back with PATCH { \"status\": \"active\" }."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "pm.test('soft delete — status flips, row stays', () =>",
              "  pm.expect(pm.response.json().status).to.eql('inactive'));"
            ]
          }
        }
      ]
    }
  ]
}
