# Base URL for the backend API. Leave as /api to use the Vite dev proxy.
VITE_API_BASE_URL=/api

# Sentry DSN. Leave empty and Sentry never initialises — which is what you want locally,
# so your stack traces don't land in the production project. Supplied to the production
# build as a --build-arg (see Dockerfile), because Vite bakes VITE_* in at build time.
VITE_SENTRY_DSN=
