# Royal Touch Roll Receiving API

PORT=4100
NODE_ENV=development

# Same connection string as the portal backend — same cluster, same credentials.
# Only the database differs: the portal writes to "Data", this writes to "RoyalTouch".
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_DB_NAME=RoyalTouch

# Must be different from each other AND from the portal backend's secrets:
#   openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# npm run seed — first login for the Android app. Change before any deployment.
SEED_EMPLOYEE_ID=EMP001
SEED_USER_PASSWORD=royal@123
SEED_USER_NAME=Royal Touch Operator
